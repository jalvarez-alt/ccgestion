# Copia este archivo como .env y completa. WA_TOKEN debe ser IGUAL al WA_TOKEN de config.py de ccgestion.
WA_TOKEN=CAMBIA_texto_largo_aleatorio
PORT=3100
FLASK_URL=https://gestion.camionesycamiones.com.co
# Pausa aleatoria entre mensajes (segundos) y descanso largo cada LOTE_TAMANO mensajes
PAUSA_MIN=8
PAUSA_MAX=20
LOTE_TAMANO=30
LOTE_PAUSA=90
# Si npm no descargo Chrome, apunta al instalado (Windows):
#CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# OneDrive (Microsoft Graph) para guardar los adjuntos recibidos. Ver README.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER=correo_dueno_del_onedrive@empresa.com
GRAPH_BASE_FOLDER=Cumplidos
